PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:<password>@localhost:5432/art_gallery

# At least 32 chars: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<your_jwt_secret>
JWT_EXPIRES_IN=1d

# Used only by `npm run db:seed -w server`. Password: 8-72 characters.
ADMIN_EMAIL=admin@gallery.local
ADMIN_PASSWORD=<your_admin_password>
ADMIN_NAME=Gallery Admin

# Where browsers reach this API; stored image URLs start with it. Leave unset locally: it
# defaults to http://localhost:$PORT and follows PORT.
# PUBLIC_URL=https://api.example.com
