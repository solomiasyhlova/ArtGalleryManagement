{
  "name": "@art-gallery/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "clean": "tsc --build --clean tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migration:generate": "tsx --env-file-if-exists=.env ../node_modules/typeorm/cli.js migration:generate -d src/db/data-source.ts",
    "db:migration:create": "tsx --env-file-if-exists=.env ../node_modules/typeorm/cli.js migration:create",
    "db:migrate": "tsx --env-file-if-exists=.env ../node_modules/typeorm/cli.js migration:run -d src/db/data-source.ts",
    "db:migration:show": "tsx --env-file-if-exists=.env ../node_modules/typeorm/cli.js migration:show -d src/db/data-source.ts",
    "db:migration:revert": "tsx --env-file-if-exists=.env ../node_modules/typeorm/cli.js migration:revert -d src/db/data-source.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts"
  },
  "dependencies": {
    "@art-gallery/shared": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15"
  }
}
